# Public Supabase client configuration. The publishable/anon key is safe for client use
# only when Row Level Security is enabled. Never put a service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Companion Quran app.
EXPO_PUBLIC_FURQAN_URL=https://furqan-quran-app.vercel.app

# Optional secure backend for current, source-linked Rafiq answers.
# Keep AI/search provider API keys on the server, never in the app.
EXPO_PUBLIC_RAFIQ_API_URL=
