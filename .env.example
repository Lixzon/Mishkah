# Set LIXZON_MASTER_KEY in your local build environment to unlock developer diagnostics.
# Use a unique random value of at least 32 bytes. Never commit the value.

# Public Supabase client configuration. The publishable/anon key is safe for client use
# only when Row Level Security is enabled. Never put a service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional secured backend endpoint for current, source-linked Rafiq answers.
# Do not put AI/search provider API keys in the app.
EXPO_PUBLIC_RAFIQ_API_URL=
